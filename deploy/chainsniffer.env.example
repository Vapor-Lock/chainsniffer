# chainsniffer settings for deploy/compose.yaml. Copy this file to chainsniffer.env and edit it.
# The two tokens are not set here: they are Compose secrets, read from secrets/wanderer.key and
# secrets/discord.token. See the README's Configuration section for what each variable does.
# Values are taken literally: no quotes, no trailing comments.

# --- Required ---

# Wanderer's address on the compose network. This assumes the Wanderer service is named
# `wanderer` and listens on Wanderer's default PORT, 8000; change either part to match your
# docker-compose.yml. Going through the compose network keeps the event stream away from the
# reverse proxy's idle timeouts and buffering. When chainsniffer runs on another host, use the
# public base URL instead, e.g. https://wanderer.example.com (no path).
CHAINSNIFFER_WANDERER_URL=http://wanderer:8000
# The map's ID or slug.
CHAINSNIFFER_WANDERER_MAP=my-chain
# The channel to post in, as a decimal snowflake.
CHAINSNIFFER_DISCORD_CHANNEL_ID=123456789012345678

# --- Filters ---

# Comma-separated EVE corporation and alliance IDs counted as friendly.
#CHAINSNIFFER_FRIENDLY_CORP_IDS=
#CHAINSNIFFER_FRIENDLY_ALLIANCE_IDS=
# Post only kills involving a friendly. Requires at least one friendly ID.
#CHAINSNIFFER_FRIENDLY_ONLY=false
# Drop kills Wanderer flagged as NPC kills.
#CHAINSNIFFER_EXCLUDE_NPC=true
# Drop kills below this total value, in ISK.
#CHAINSNIFFER_MIN_VALUE=0
# Drop kills older than this Go duration.
#CHAINSNIFFER_MAX_KILL_AGE=1h
# Known-space classes whose kills are posted: any of highsec, lowsec, nullsec, or none.
#CHAINSNIFFER_KSPACE=none

# --- Home chain ---

# EVE solar system ID of the home system; when set, kills in systems not linked to it are dropped.
#CHAINSNIFFER_HOME_SYSTEM_ID=
# How often the map's topology and chain aliases are reloaded, as a Go duration.
#CHAINSNIFFER_TOPOLOGY_RESYNC_INTERVAL=15m

# --- Runtime ---

# The state volume is mounted here by compose.yaml; change both together.
#CHAINSNIFFER_STATE_DIR=/var/lib/chainsniffer
# debug, info, warn or error.
#CHAINSNIFFER_LOG_LEVEL=info
# text or json; json suits docker logs and log shippers.
CHAINSNIFFER_LOG_FORMAT=json
# components, strip (needs Attach Files), block or fields.
#CHAINSNIFFER_CARD_STYLE=components
# Replay mode posts the last saved kill to this channel and exits; leave unset for a relay.
#CHAINSNIFFER_REPLAY_CHANNEL_ID=
